# ==== إعدادات الاتصال ====
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# ==== قاعدة البيانات ====
# عند تعيين DATABASE_URL يعمل المتجر على PostgreSQL (مثل Supabase).
# عند تركه فارغاً يعمل على SQLite محلياً (store.db).
DATABASE_URL=

# في حال تعذر الاتصال بشهادة SSL (نادر مع Supabase)
# PGSSLMODE=disable

# ==== رفع الصور إلى Cloudinary ====
# عند تعبئة الثلاثة تعمل الصور عبر Cloudinary (روابط https دائمة).
# عند تركها فارغة تُحفظ الصور في public/uploads محلياً.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
