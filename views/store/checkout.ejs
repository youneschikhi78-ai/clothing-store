<%- include('../partials/header') %>

<div class="container page-head">
  <h1>إتمام الطلب</h1>
</div>

<div class="container checkout-layout">
  <form action="/checkout" method="POST" class="checkout-form card">
    <h3>بيانات الشحن</h3>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
    <div class="form-grid">
      <div class="form-group">
        <label>الاسم الكامل *</label>
        <input type="text" name="name" value="<%= user ? user.name : '' %>" required>
      </div>
      <div class="form-group">
        <label>رقم الهاتف *</label>
        <input type="tel" name="phone" placeholder="01xxxxxxxxx" required>
      </div>
      <div class="form-group">
        <label><%= zones.length ? 'الولاية *' : 'المدينة *' %></label>
        <% if (zones.length > 0) { %>
          <select name="city" id="zoneSelect" required>
            <option value="">— اختر الولاية —</option>
            <% zones.forEach(z => { %>
              <option value="<%= z.name %>" data-price="<%= z.price %>" <%= selectedCity === z.name ? 'selected' : '' %>><%= z.name %> (<%= z.price === 0 ? 'مجاني' : z.price.toLocaleString('ar-EG-u-nu-latn') + ' ' + (site.currency || 'ج.م') %>)</option>
            <% }) %>
          </select>
          <p class="muted">الشحن يتم فقط إلى الولايات المتاحة أعلاه</p>
        <% } else { %>
          <input type="text" name="city" value="<%= selectedCity %>" required>
        <% } %>
      </div>
      <div class="form-group">
        <label>العنوان بالتفصيل *</label>
        <input type="text" name="address" required>
      </div>
    </div>
    <div class="form-group">
      <label>ملاحظات (اختياري)</label>
      <textarea name="notes" rows="3"></textarea>
    </div>

    <div class="checkout-summary">
      <h3>ملخص الطلب</h3>
      <% cart.items.forEach(it => { %>
        <div class="summary-row">
          <span><%= it.name %> × <%= it.qty %></span>
          <span><%= (it.price * it.qty).toLocaleString('ar-EG-u-nu-latn') %> <%= site.currency || 'ج.م' %></span>
        </div>
      <% }) %>
      <div class="summary-row">
        <span>الشحن</span>
        <span id="shippingCell"><%= shippingCost === null ? 'اختر الولاية' : (shippingCost === 0 ? 'مجاني' : shippingCost.toLocaleString('ar-EG-u-nu-latn') + ' ' + (site.currency || 'ج.م')) %></span>
      </div>
      <% if (freeOver > 0 && zones.length === 0) { %>
        <p class="muted">توصيل مجاني للطلبات فوق <%= freeOver.toLocaleString('ar-EG-u-nu-latn') %> <%= site.currency || 'ج.م' %></p>
      <% } %>
      <hr>
      <div class="summary-row total">
        <span>الإجمالي</span>
        <span id="totalCell"><%= (cart.total + (shippingCost || 0)).toLocaleString('ar-EG-u-nu-latn') %> <%= site.currency || 'ج.م' %></span>
      </div>
    </div>

    <button type="submit" class="btn btn-primary btn-lg btn-block">الدفع عند الاستلام</button>
  </form>
</div>

<% if (zones.length > 0) { %>
<script>
  (function () {
    var sel = document.getElementById('zoneSelect');
    var base = <%= cart.total %>;
    var ship = document.getElementById('shippingCell');
    var total = document.getElementById('totalCell');
    var currency = '<%= site.currency || 'ج.م' %>';
    var fmt = function (n) { return n.toLocaleString('ar-EG-u-nu-latn'); };
    function upd() {
      var opt = sel.options[sel.selectedIndex];
      var price = opt && opt.value ? parseFloat(opt.dataset.price) : NaN;
      if (opt && opt.value && !isNaN(price)) {
        ship.textContent = price === 0 ? 'مجاني' : fmt(price) + ' ' + currency;
        total.textContent = fmt(base + price) + ' ' + currency;
      } else {
        ship.textContent = 'اختر الولاية';
        total.textContent = fmt(base) + ' ' + currency;
      }
    }
    sel.addEventListener('change', upd);
  })();
</script>
<% } %>

<%- include('../partials/footer') %>
