<%- include('../partials/header') %>

<div class="container page-head">
  <h1>طلباتي</h1>
</div>

<div class="container">
  <% if (orders.length === 0) { %>
    <div class="empty-state">
      <p>لا توجد طلبات بعد</p>
      <a href="/products" class="btn btn-primary">ابدأ التسوق</a>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>رقم الطلب</th>
            <th>التاريخ</th>
            <th>الإجمالي</th>
            <th>الحالة</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% orders.forEach(o => { %>
            <tr>
              <td>#<%= o.id %></td>
              <td><%= new Date(o.created_at).toLocaleString('ar-EG-u-nu-latn') %></td>
              <td><%= o.total.toLocaleString('ar-EG-u-nu-latn') %> <%= site.currency || 'ج.م' %></td>
              <td><span class="status status-<%= o.status %>"><%= statuses[o.status] || o.status %></span></td>
              <td><a href="/order/<%= o.id %>" class="btn btn-ghost btn-sm">التفاصيل</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
