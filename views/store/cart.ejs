<%- include('../partials/header') %>

<div class="container page-head">
  <h1>سلة التسوق</h1>
</div>

<div class="container">
  <% if (cart.items.length === 0) { %>
    <div class="empty-state">
      <p>سلة التسوق فارغة</p>
      <a href="/products" class="btn btn-primary">تصفح المنتجات</a>
    </div>
  <% } else { %>
    <div class="cart-layout">
      <div class="cart-items">
        <% cart.items.forEach(it => { %>
          <div class="cart-item">
            <div class="cart-item-image <%= it.image ? '' : 'placeholder small' %>">
              <% if (it.image) { %><img src="<%= it.image %>" alt=""><% } else { %><span><%= it.name.charAt(0) %></span><% } %>
            </div>
            <div class="cart-item-info">
              <h3><a href="/product/<%= it.id %>"><%= it.name %></a></h3>
              <span class="price-current"><%= it.price.toLocaleString('ar-EG') %> <%= site.currency || 'ج.م' %></span>
            </div>
            <form action="/cart/update" method="POST" class="qty-control">
              <input type="hidden" name="id" value="<%= it.id %>">
              <input type="number" name="qty" value="<%= it.qty %>" min="1">
              <button type="submit" class="btn btn-ghost btn-sm">تحديث</button>
            </form>
            <div class="cart-item-total">
              <%= (it.price * it.qty).toLocaleString('ar-EG') %> <%= site.currency || 'ج.م' %>
            </div>
            <form action="/cart/remove" method="POST">
              <input type="hidden" name="id" value="<%= it.id %>">
              <button type="submit" class="btn btn-danger btn-sm">حذف</button>
            </form>
          </div>
        <% }) %>
      </div>
      <div class="cart-summary card">
        <h3>ملخص الطلب</h3>
        <div class="summary-row">
          <span>المنتجات</span>
          <span><%= cart.total.toLocaleString('ar-EG') %> <%= site.currency || 'ج.م' %></span>
        </div>
        <div class="summary-row">
          <span>الشحن</span>
          <span>يُحسب عند إتمام الطلب</span>
        </div>
        <hr>
        <div class="summary-row total">
          <span>الإجمالي</span>
          <span><%= cart.total.toLocaleString('ar-EG') %> <%= site.currency || 'ج.م' %></span>
        </div>
        <a href="/checkout" class="btn btn-primary btn-block">إتمام الطلب</a>
        <a href="/products" class="btn btn-ghost btn-block">متابعة التسوق</a>
      </div>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
