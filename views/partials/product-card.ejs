<%
const p = product;
const img = p.image ? p.image : null;
const hasDiscount = p.old_price && p.old_price > p.price;
%>
<a class="product-card" href="/product/<%= p.id %>">
  <div class="product-image <%= img ? '' : 'placeholder' %>">
    <% if (img) { %>
      <img src="<%= img %>" alt="<%= p.name %>" loading="lazy">
    <% } else { %>
      <span><%= p.name.charAt(0) %></span>
    <% } %>
    <% if (hasDiscount) { %>
      <span class="badge badge-sale">خصم <%= Math.round((1 - p.price / p.old_price) * 100) %>%</span>
    <% } %>
    <% if (p.stock === 0) { %>
      <span class="badge badge-out">نفدت الكمية</span>
    <% } %>
  </div>
  <div class="product-info">
    <h3><%= p.name %></h3>
    <p class="product-category"><%= p.category_name || '' %></p>
    <div class="product-price">
      <span class="price-current"><%= p.price.toLocaleString('ar-EG') %> <%= site.currency || 'ج.م' %></span>
      <% if (hasDiscount) { %>
        <span class="price-old"><%= p.old_price.toLocaleString('ar-EG') %></span>
      <% } %>
    </div>
  </div>
</a>
